{
  "openapi": "3.1.0",
  "info": {
    "title": "Shoogle Price API",
    "version": "1.2.0",
    "description": "Shoogle JSON API for Iranian fiat currency, cryptocurrency, physical gold and coin spot prices, with source-attributed historical charts, verified fallbacks, and API documentation."
  },
  "servers": [
    {
      "url": "https://price.shoogle.ir"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/prices": {
      "get": {
        "summary": "Get all currency and gold prices",
        "operationId": "getAllPrices",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "responses": {
          "200": {
            "description": "Combined price response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/v1/currencies": {
      "get": {
        "summary": "Get currency prices",
        "operationId": "getCurrencies",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "description": "Comma-separated symbols. Example: USD,EUR,AED",
            "schema": {
              "type": "string"
            },
            "example": "USD,EUR"
          }
        ],
        "responses": {
          "200": {
            "description": "Currency prices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrencyResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/v1/gold": {
      "get": {
        "summary": "Get gold and coin prices",
        "operationId": "getGoldPrices",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "description": "Comma-separated symbols. Example: GOLD_18K,EMAMI,XAU_OUNCE",
            "schema": {
              "type": "string"
            },
            "example": "GOLD_18K,EMAMI"
          }
        ],
        "responses": {
          "200": {
            "description": "Gold and coin prices",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GoldResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/v1/fiats": {
      "get": {
        "summary": "Get full ArzDigital fiat metadata",
        "operationId": "getFiats",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "description": "Comma-separated symbols. Example: USD,EUR,AED",
            "schema": {
              "type": "string"
            },
            "example": "USD,EUR"
          }
        ],
        "responses": {
          "200": {
            "description": "Fiat metadata including asset id, toman/USD price, change percentages, ATH/ATL and chart capability",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FiatListResponse"
                }
              }
            }
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/v1/fiats/{symbol}": {
      "get": {
        "summary": "Get one fiat asset and all available metadata",
        "operationId": "getFiat",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "USD"
          }
        ],
        "responses": {
          "200": {
            "description": "Fiat asset metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Fiat not found"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/v1/fiats/{symbol}/chart": {
      "get": {
        "summary": "Get historical fiat chart data",
        "operationId": "getFiatChart",
        "security": [
          {
            "ApiKeyAuth": []
          },
          {}
        ],
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "USD"
          },
          {
            "name": "range",
            "in": "query",
            "required": false,
            "description": "Historical range",
            "schema": {
              "type": "string",
              "enum": [
                "1d",
                "7d",
                "1m",
                "3m",
                "6m",
                "1y",
                "all"
              ],
              "default": "1m"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Historical series plus upstream low/high metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FiatChartResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid range"
          },
          "404": {
            "description": "Fiat not found"
          },
          "502": {
            "$ref": "#/components/responses/UpstreamError"
          }
        }
      }
    },
    "/api/v1/history/{symbol}": {
      "get": {
        "summary": "Historical prices for supported fiat currencies",
        "description": "Historical chart with verified observed prices, summary and actual source/provider. Fiat: ArzDigital chart. Crypto: snapshot archive → ArzDigital mapped asset-ID chart → dated ArzDigital table. Gold/coins: snapshot archive → Alanchand CSRF chart → ArzDigital mapped gold/coin chart → TGJU daily series. USD quotes are multiplied by the contemporaneous Toman/USD rate. Missing data is not synthesized.",
        "operationId": "getFiatHistory",
        "parameters": [
          {
            "name": "symbol",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "USD"
          },
          {
            "name": "range",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "1d",
                "7d",
                "1m",
                "3m",
                "6m",
                "1y",
                "all"
              ],
              "default": "7d"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Time series in toman and summary statistics",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "Unsupported range"
          },
          "404": {
            "description": "Verified history unavailable for the selected asset and period"
          },
          "502": {
            "description": "Upstream error"
          }
        }
      }
    },
    "/api/v1/crypto": {
      "get": {
        "summary": "Current cryptocurrency prices from Alanchand",
        "parameters": [
          {
            "name": "symbols",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cryptocurrency spot prices"
          },
          "502": {
            "description": "Provider unavailable"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Discover API endpoints and base URL",
        "operationId": "getApiInfo",
        "responses": {
          "200": {
            "description": "Service metadata and endpoint paths",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/openapi.json": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Download the OpenAPI 3.1 specification",
        "operationId": "getOpenApi",
        "responses": {
          "200": {
            "description": "OpenAPI specification",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/AGENTS.md": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Read AI agent integration guide",
        "operationId": "getAgentGuide",
        "responses": {
          "200": {
            "description": "Agent guide in Markdown",
            "content": {
              "text/markdown": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/docs": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Open interactive Swagger UI",
        "operationId": "getSwaggerDocs",
        "responses": {
          "200": {
            "description": "Swagger UI documentation page",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Only required when API_KEYS is configured on the server."
      }
    },
    "responses": {
      "UpstreamError": {
        "description": "Upstream site could not be fetched or parsed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            }
          }
        }
      }
    },
    "schemas": {
      "CurrencyItem": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "buy",
          "sell",
          "unit"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "example": "USD"
          },
          "name": {
            "type": "string",
            "example": "دلار آمریکا"
          },
          "buy": {
            "type": [
              "number",
              "null"
            ],
            "example": 250650
          },
          "sell": {
            "type": [
              "number",
              "null"
            ],
            "example": 253200
          },
          "per_usd": {
            "type": [
              "number",
              "null"
            ],
            "example": null
          },
          "unit": {
            "type": "string",
            "enum": [
              "toman"
            ]
          },
          "raw": {
            "type": "object"
          },
          "reference_price": {
            "type": [
              "number",
              "null"
            ],
            "description": "Reference price used by the fallback provider."
          },
          "price_mode": {
            "type": "string",
            "enum": [
              "bid_ask",
              "reference"
            ],
            "description": "bid_ask for primary data; reference when ArzDigital is supplying the fallback price."
          },
          "source_provider": {
            "type": "string",
            "enum": [
              "alanchand",
              "arzdigital"
            ]
          },
          "asset_id": {
            "type": [
              "integer",
              "null"
            ],
            "description": "ArzDigital asset id when available."
          },
          "chart_available": {
            "type": "boolean"
          },
          "last_updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "market": {
            "type": [
              "object",
              "null"
            ],
            "description": "ArzDigital enrichment such as USD value and price-change percentages."
          }
        }
      },
      "GoldItem": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "price",
          "unit"
        ],
        "properties": {
          "symbol": {
            "type": "string",
            "example": "GOLD_18K"
          },
          "name": {
            "type": "string",
            "example": "گرم طلای 18 عیار"
          },
          "price": {
            "type": "number",
            "example": 24770300
          },
          "change_percent": {
            "type": [
              "number",
              "null"
            ],
            "example": 1.42
          },
          "real_price": {
            "type": [
              "number",
              "null"
            ],
            "example": 25229000
          },
          "bubble_amount": {
            "type": [
              "number",
              "null"
            ],
            "example": -458700
          },
          "bubble_percent": {
            "type": [
              "number",
              "null"
            ],
            "example": -1.82
          },
          "unit": {
            "type": "string",
            "enum": [
              "toman",
              "usd"
            ]
          },
          "raw": {
            "type": "object"
          }
        }
      },
      "CurrencyResponse": {
        "type": "object",
        "required": [
          "ok",
          "type",
          "count",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "type": {
            "type": "string",
            "const": "currencies"
          },
          "count": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "source_updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "cache": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyItem"
            }
          },
          "provider": {
            "type": "string",
            "example": "alanchand+arzdigital"
          },
          "failover_used": {
            "type": "boolean"
          },
          "coverage_augmented": {
            "type": "boolean"
          },
          "fallback_only_count": {
            "type": "integer"
          },
          "primary_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "fallback_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "GoldResponse": {
        "type": "object",
        "required": [
          "ok",
          "type",
          "count",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "type": {
            "type": "string",
            "const": "gold"
          },
          "count": {
            "type": "integer"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "source_updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "cache": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GoldItem"
            }
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "ok",
          "error"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "FiatAsset": {
        "type": "object",
        "required": [
          "id",
          "symbol",
          "toman",
          "type"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 24201
          },
          "slug": {
            "type": [
              "string",
              "null"
            ]
          },
          "symbol": {
            "type": "string",
            "example": "USD"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "example": "United States Dollar"
          },
          "fa_name": {
            "type": [
              "string",
              "null"
            ],
            "example": "دلار"
          },
          "logo": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "usd": {
            "type": [
              "number",
              "null"
            ],
            "example": 1
          },
          "toman": {
            "type": [
              "number",
              "null"
            ],
            "example": 269000
          },
          "type": {
            "type": "string",
            "example": "fiat"
          },
          "last_updated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "ath_atl": {
            "type": [
              "object",
              "null"
            ]
          }
        },
        "additionalProperties": true
      },
      "FiatListResponse": {
        "type": "object",
        "required": [
          "ok",
          "type",
          "provider",
          "count",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "type": {
            "type": "string",
            "const": "fiats"
          },
          "provider": {
            "type": "string",
            "const": "arzdigital"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "count": {
            "type": "integer"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "cache": {
            "type": "string"
          },
          "supported_chart_ranges": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "1d",
                "7d",
                "1m",
                "3m",
                "6m",
                "1y",
                "all"
              ]
            }
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FiatAsset"
            }
          }
        }
      },
      "ChartPoint": {
        "type": "object",
        "required": [
          "timestamp_ms",
          "timestamp",
          "raw"
        ],
        "properties": {
          "timestamp_ms": {
            "type": "integer",
            "format": "int64"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "usd": {
            "type": [
              "number",
              "null"
            ]
          },
          "toman": {
            "type": [
              "number",
              "null"
            ]
          },
          "auxiliary": {
            "type": [
              "number",
              "null"
            ],
            "description": "Fourth upstream chart value preserved numerically because the upstream public response does not name the column."
          },
          "raw": {
            "type": "array",
            "items": {}
          }
        }
      },
      "FiatChartResponse": {
        "type": "object",
        "required": [
          "ok",
          "symbol",
          "provider",
          "range",
          "asset_id",
          "meta",
          "data"
        ],
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          },
          "symbol": {
            "type": "string",
            "example": "USD"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "provider": {
            "type": "string",
            "const": "arzdigital"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "range": {
            "type": "string",
            "enum": [
              "1d",
              "7d",
              "1m",
              "3m",
              "6m",
              "1y",
              "all"
            ]
          },
          "asset_id": {
            "type": "integer",
            "example": 24201
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "meta": {
            "type": "object"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChartPoint"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System",
      "description": "Service discovery, health, OpenAPI schema and agent documentation"
    },
    {
      "name": "Prices",
      "description": "Live market quotes"
    },
    {
      "name": "History",
      "description": "Source-attributed historical market prices"
    }
  ]
}
